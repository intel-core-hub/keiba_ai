    graph.add_relationship(

        source_name=
            "Market Crash",

        target_name=
            "Liquidity Stress",

        relation_type=
            "CAUSES",

        weight=0.91,
    )

    graph.add_relationship(

        source_name=
            "Liquidity Stress",

        target_name=
            "Survival Threat",

        relation_type=
            "CAUSES",

        weight=0.88,
    )

    print(
        graph.snapshot()
    )

    print(

        graph.infer_connections(
