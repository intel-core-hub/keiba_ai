@dataclass
class HorseFeatures:
    """
    Horse Feature Schema

    目的:
    - feature固定化
    - leakage防止
    - pipeline統一
    - training consistency

    最重要:
    「特徴量定義を固定する」
    """

    # =================================================
    # Identity
    # =================================================

    race_id: str

    horse_id: str

    horse_name: str

