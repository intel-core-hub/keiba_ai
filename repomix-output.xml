⋮----
# Mask long hex/base64-looking strings (>=40 chars)
text = re.sub(r'[A-Fa-f0-9]{40,}', '<REDACTED_HEX>', text)
text = re.sub(r'([A-Za-z0-9+/]{40,}={0,2})', '<REDACTED_B64>', text)
